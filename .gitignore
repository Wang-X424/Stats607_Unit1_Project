# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# environment
.venv/

# OS / editor
.DS_Store
.vscode/

# inputs: public MNIST files are downloaded by `make data`, never committed
data/raw/*
data/processed/*
!data/**/.gitkeep

# final outputs are regenerated by `make results`
results/figures/*
results/tables/*
!results/**/.gitkeep

# artifacts/runs/*.npz ARE committed: they are the checkpoint behind `make results`
